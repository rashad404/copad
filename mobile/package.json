{
  "name": "azdoc-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 3003",
    "android": "AZDOC_BUILD_VARIANT=preview expo run:android --port 3003",
    "ios": "AZDOC_BUILD_VARIANT=preview expo run:ios --device --port 3003",
    "web": "expo start --web --port 3003",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "export": "expo export --platform all",
    "dev": "node scripts/preview.cjs",
    "test:browser": "node tests/browser-smoke.cjs",
    "build:ios:preview": "zsh scripts/build-ios-preview.sh",
    "build:android:preview": "zsh scripts/build-android-preview.sh",
    "test:parity": "node scripts/test-parity.cjs",
    "sync:website-copy": "node scripts/sync-website-copy.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@expo/vector-icons": "^14.1.0",
    "@kingstinct/react-native-healthkit": "^8.7.2",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "^8.4.1",
    "@react-navigation/bottom-tabs": "^7.3.15",
    "@react-navigation/elements": "^2.9.40",
    "@react-navigation/native": "^7.1.11",
    "@react-navigation/native-stack": "^7.3.16",
    "axios": "^1.10.0",
    "expo": "~53.0.11",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "^18.1.10",
    "expo-font": "^13.3.1",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "^0.30.9",
    "expo-status-bar": "~2.2.3",
    "expo-web-browser": "~14.2.0",
    "markdown-it": "^15.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "^0.79.6",
    "react-native-blob-util": "^0.22.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-pdf": "^7.0.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "^4.11.1",
    "react-native-svg": "^15.11.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "~19.0.10",
    "playwright": "^1.61.1",
    "typescript": "~5.8.3"
  },
  "private": true
}
